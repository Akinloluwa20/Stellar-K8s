{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "StellarUpgrade custom resource",
  "properties": {
    "spec": {
      "type": "object",
      "required": [
        "targetNode",
        "targetVersion",
        "canaryStrategy",
        "healthValidation",
        "rollbackPolicy"
      ],
      "properties": {
        "targetNode": {
          "type": "string"
        },
        "targetVersion": {
          "type": "string"
        },
        "canaryStrategy": {
          "type": "object",
          "properties": {
            "initialTrafficPercent": {
              "type": "integer"
            },
            "trafficIncrementPercent": {
              "type": "integer"
            },
            "incrementIntervalSecs": {
              "type": "integer"
            }
          }
        },
        "healthValidation": {
          "type": "object",
          "properties": {
            "consensusHealthy": {
              "type": "boolean"
            },
            "syncStateHealthy": {
              "type": "boolean"
            },
            "apiResponding": {
              "type": "boolean"
            },
            "errorRateThresholdPercent": {
              "type": "number"
            }
          }
        },
        "rollbackPolicy": {
          "type": "object",
          "properties": {
            "automaticRollback": {
              "type": "boolean"
            },
            "rollbackOnErrorRate": {
              "type": "boolean"
            },
            "errorRateThresholdPercent": {
              "type": "number"
            },
            "rollbackTimeoutSecs": {
              "type": "integer"
            }
          }
        }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "Pending",
            "CanaryDeployed",
            "ProgressiveRollout",
            "Completed",
            "RolledBack",
            "Failed"
          ]
        },
        "canaryReady": {
          "type": "boolean"
        },
        "trafficPercent": {
          "type": "integer"
        },
        "healthChecksPasssed": {
          "type": "integer"
        },
        "healthChecksFailed": {
          "type": "integer"
        },
        "lastUpdateTime": {
          "type": "string"
        },
        "rollbackInProgress": {
          "type": "boolean"
        }
      }
    },
    "apiVersion": {
      "type": "string",
      "enum": [
        "stellar.org/v1alpha1"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "StellarUpgrade"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata"
  ],
  "additionalProperties": true,
  "x-kubernetes-group-version-kind": [
    {
      "group": "stellar.org",
      "version": "v1alpha1",
      "kind": "StellarUpgrade"
    }
  ]
}
